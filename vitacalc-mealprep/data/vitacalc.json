    "recettes": [
        {
            "id": 1,
            "nom": "Bowl poulet & quinoa",
            "description": "Un bowl protéiné et équilibré, parfait pour le déjeuner de la semaine.",
            "instructions": "Cuire le quinoa.\nGriller le poulet assaisonné.\nDécouper les légumes.\nAssembler dans des boîtes et conserver au frais.",
            "tempsPreparation": 35,
            "nombrePortions": 4,
            "image": "assets\/images\/recettes\/bowl-poulet-quinoa.jpg",
            "moment": "dejeuner"
        },
        {
            "id": 2,
            "nom": "Overnight oats banane",
            "description": "Petit-déjeuner prêt la veille, riche en fibres et sans cuisson.",
            "instructions": "Mélanger les flocons d'avoine et le lait.\r\nAjouter la banane écrasée.\r\nLaisser reposer une nuit au réfrigérateur.",
            "tempsPreparation": 10,
            "nombrePortions": 2,
            "image": "assets\/uploads\/img_39edc78282fe9c0f.webp",
            "moment": "matin"
        },
        {
            "id": 3,
            "nom": "Salade quinoa avocat",
            "description": "Une salade fraîche et rassasiante, pleine de bons gras.",
            "instructions": "Cuire le quinoa et le laisser refroidir.\r\nCouper l'avocat, la tomate et le concombre en dés.\r\nMélanger avec le quinoa.\r\nAssaisonner avec l'huile d'olive et le jus de citron.",
            "tempsPreparation": 20,
            "nombrePortions": 3,
            "image": "assets\/uploads\/img_99d0b5c53c5a9dff.jpg",
            "moment": "dejeuner"
        },
        {
            "id": 4,
            "nom": "Saumon grillé & brocoli",
            "description": "Riche en oméga-3 : un dîner léger et plein de saveurs.",
            "instructions": "Cuire le riz.\r\nMariner le saumon avec le citron et l'huile d'olive.\r\nGriller le saumon 4 minutes de chaque côté.\r\nCuire le brocoli à la vapeur et servir ensemble.",
            "tempsPreparation": 30,
            "nombrePortions": 4,
            "image": "assets\/uploads\/img_c42c7a1601cb5aa5.jpg",
            "moment": "diner"
        },
        {
            "id": 5,
            "nom": "Omelette aux épinards",
            "description": "Une omelette moelleuse, riche en protéines et en fer.",
            "instructions": "Battre les œufs avec une pincée de sel.\r\nFaire revenir les épinards dans l'huile d'olive.\r\nVerser les œufs, ajouter le fromage.\r\nCuire à feu doux puis plier l'omelette.",
            "tempsPreparation": 15,
            "nombrePortions": 2,
            "image": "assets\/uploads\/img_e915b1811035bc9a.jpg",
            "moment": "matin"
        },
        {
            "id": 6,
            "nom": "Smoothie bowl fraise-banane",
            "description": "Un petit-déjeuner coloré, frais et plein de vitamines.",
            "instructions": "Mixer la banane, les fraises et le yaourt.\r\nVerser dans un bol.\r\nAjouter les flocons d'avoine et un filet de miel.",
            "tempsPreparation": 10,
            "nombrePortions": 2,
            "image": "assets\/uploads\/img_9c9b8d1413942d1f.jpg",
            "moment": "matin"
        },
        {
            "id": 7,
            "nom": "Wrap poulet & légumes croquants",
